# ─────────────────────────────────────────────────────────
# IT Helpdesk — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────

# Neon PostgreSQL — Pooled connection (used by the app at runtime via pgbouncer)
# Get this from: Neon dashboard → your project → Connection string → Pooled
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"

# Neon PostgreSQL — Direct connection (used by Prisma migrations / db push)
# Get this from: Neon dashboard → your project → Connection string → Direct
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# JWT — any long random string (min 32 chars recommended)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here"

# Next.js public base URL (required for NextAuth and redirects)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth secret (can be same as JWT_SECRET or different)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
